---
import { formatCalendarDate } from '../lib/dates'
import { sizedImageUrl } from '../lib/image-url'
import { clusterPins, type MapOuting, type MapPin, mapFrame } from '../lib/place-map'
import { outingName } from '../lib/places'

interface Props {
  /** Which prebuilt map to draw on (a chapter slug). */
  map: string
  name: string
  outings: MapOuting[]
}

const { map, name, outings } = Astro.props
const frame = mapFrame(map)

// Pins are 6% of the map's width (see --pin), so a single merge distance fits
// every desktop width. Phones hit the 34px floor on a ~330px map, about 10.5%.
const wide = frame ? clusterPins(frame, outings, 0.062) : []
const narrow = frame ? clusterPins(frame, outings, 0.105) : []

function when(date: string | null, month: 'short' | 'long' = 'long'): string | null {
  return date ? formatCalendarDate(date, { month, year: 'numeric' }) : null
}

function label(pin: MapPin): string {
  const lead = outingName(pin.lead.title)
  if (pin.count === 1) return [lead, when(pin.lead.date)].filter(Boolean).join(', ')
  const where = pin.groups[0] ? ` in ${pin.groups[0].name}` : ' around here'
  return `${pin.count} outings${where}, most recently ${lead}`
}

// A single outing on a place page links straight to it; anything else opens a
// list, so a merged pin never hides the outings under it.
const opensList = (pin: MapPin) => pin.count > 1 || pin.groups.length > 0
---

{frame && wide.length > 0 && (
  <figure
    class="place-map"
    style={`--map-ratio: ${frame.width / frame.height}; --map-land: url(/maps/${map}-land.svg); --map-lines: url(/maps/${map}-lines.svg); --map-contours: url(/maps/${map}-contours.svg);`}
    aria-label={`Map of outings in ${name}`}
  >
    <div class="place-map-canvas">
      <div class="place-map-layer place-map-land" aria-hidden="true"></div>
      <div class="place-map-layer place-map-contours" aria-hidden="true"></div>
      <div class="place-map-layer place-map-lines" aria-hidden="true"></div>
      {[
        ['wide', wide],
        ['narrow', narrow],
      ].map(([density, pins]) => (
        <ul class={`place-map-pins place-map-pins-${density}`}>
          {(pins as MapPin[]).map((pin, index) => {
            const id = `place-map-${map}-${density}-${index}`
            const face = (
              <>
                {pin.lead.cover ? (
                  <img src={sizedImageUrl(pin.lead.cover, 200)} alt="" loading="lazy" width="80" height="80" />
                ) : (
                  <span class="place-map-pin-blank"></span>
                )}
                {pin.count > 1 && <span class="place-map-count" aria-hidden="true">{pin.count}</span>}
              </>
            )
            return (
              <li style={`left: ${(pin.x * 100).toFixed(2)}%; top: ${(pin.y * 100).toFixed(2)}%;`}>
                {opensList(pin) ? (
                  <>
                    <button type="button" class="place-map-pin" popovertarget={id} aria-label={label(pin)} title={label(pin)}>
                      {face}
                    </button>
                    <div id={id} class="place-map-list" popover="auto" aria-label={label(pin)}>
                      <div class="place-map-list-head">
                        <p class="place-map-list-title">
                          {pin.count} {pin.count === 1 ? 'outing' : 'outings'}
                          {pin.groups.length === 0 && ' around here'}
                        </p>
                        <button type="button" class="place-map-list-close" popovertarget={id} popovertargetaction="hide" aria-label="Close">
                          &times;
                        </button>
                      </div>
                      {pin.groups.length > 0 && (
                        <p class="place-map-list-places">
                          {pin.groups.map(group => (
                            <a class="text-link" href={group.href}>
                              {group.name} <span class="measure">{group.count}</span> <span aria-hidden="true">→</span>
                            </a>
                          ))}
                        </p>
                      )}
                      <ol class="place-map-list-outings">
                        {pin.members.map(outing => (
                          <li>
                            <a href={outing.href}>
                              {outing.cover ? (
                                <img src={sizedImageUrl(outing.cover, 200)} alt="" loading="lazy" width="48" height="48" />
                              ) : (
                                <span class="place-map-pin-blank"></span>
                              )}
                              <span class="place-map-list-name">{outingName(outing.title)}</span>
                              <span class="measure">{when(outing.date, 'short')}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </>
                ) : (
                  <a class="place-map-pin" href={pin.lead.href} aria-label={label(pin)} title={label(pin)}>
                    {face}
                  </a>
                )}
              </li>
            )
          })}
        </ul>
      ))}
    </div>
    <figcaption class="place-map-credit">
      <a href="#map-sources">Map sources<span aria-hidden="true">*</span></a>
    </figcaption>
  </figure>
)}

<style>
  .place-map {
    margin: var(--space-xl) 0 0;
  }

  .place-map-canvas {
    position: relative;
    width: min(100%, calc(72vh * var(--map-ratio)));
    aspect-ratio: var(--map-ratio);
    margin-inline: auto;
    container-type: inline-size;
    background: color-mix(in srgb, var(--water) 9%, var(--paper));
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
  }

  .place-map-layer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
  }

  .place-map-land {
    background: var(--paper);
    mask-image: var(--map-land);
    -webkit-mask-image: var(--map-land);
  }

  /* Contours are texture, not information: faint enough that borders and pins lead. */
  .place-map-contours {
    background: color-mix(in srgb, var(--contour) 32%, transparent);
  }

  :global([data-theme='dark']) .place-map-contours {
    background: color-mix(in srgb, var(--contour) 42%, transparent);
  }

  .place-map-contours {
    mask-image: var(--map-contours);
    -webkit-mask-image: var(--map-contours);
  }

  .place-map-lines {
    background: color-mix(in srgb, var(--ink) 50%, transparent);
    mask-image: var(--map-lines);
    -webkit-mask-image: var(--map-lines);
  }

  .place-map-pins {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .place-map-pins li {
    position: absolute;
    transform: translate(-50%, -100%);
  }

  .place-map-pins li:hover,
  .place-map-pins li:focus-within {
    z-index: 1;
  }

  .place-map-pin {
    --pin: clamp(34px, 6cqw, 64px);
    position: relative;
    display: block;
    padding: 0;
    cursor: pointer;
    width: var(--pin);
    height: var(--pin);
    margin-bottom: 7px;
    background: var(--color-white);
    border: 2px solid var(--color-white);
    border-radius: 9px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    transition: transform var(--transition-fast);
    transform-origin: 50% calc(100% + 7px);
  }

  /* The tail points at the outing's location. */
  .place-map-pin::after {
    position: absolute;
    bottom: -8px;
    left: 50%;
    width: 0;
    height: 0;
    content: '';
    border-top: 7px solid var(--color-white);
    border-right: 6px solid transparent;
    border-left: 6px solid transparent;
    transform: translateX(-50%);
  }

  .place-map-pin img,
  .place-map-pin-blank {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--paper-deep);
    border-radius: 7px;
  }

  .place-map-count {
    position: absolute;
    bottom: 3px;
    left: 5px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }

  @media (hover: hover) and (pointer: fine) {
    .place-map-pin:hover {
      text-decoration: none;
      transform: scale(1.08);
    }
  }

  .place-map-pin:focus-visible {
    outline: 2px solid var(--tab);
    outline-offset: 2px;
  }

  .place-map-pins-narrow {
    display: none;
  }

  .place-map-credit {
    width: min(100%, calc(72vh * var(--map-ratio)));
    margin: 0.4rem auto 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-align: right;
  }

  .place-map-credit a {
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .place-map-pins-wide {
      display: none;
    }

    .place-map-pins-narrow {
      display: block;
    }

    .place-map-pin {
      border-radius: 7px;
    }

    .place-map-pin img,
    .place-map-pin-blank {
      border-radius: 5px;
    }

    .place-map-count {
      font-size: 0.7rem;
    }
  }

  /* The outing list sits in the top layer, centered, so it never clips at a map edge. */
  .place-map-list {
    width: min(26rem, calc(100vw - 2rem));
    max-height: min(32rem, 75vh);
    padding: 0;
    margin: auto;
    overflow: auto;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms ease,
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      overlay 180ms allow-discrete,
      display 180ms allow-discrete;
  }

  @starting-style {
    .place-map-list:popover-open {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .place-map-list:not(:popover-open) {
    opacity: 0;
  }

  .place-map-list::backdrop {
    background: rgba(0, 0, 0, 0.25);
  }

  .place-map-list-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    background: var(--paper);
    border-bottom: 1px solid var(--color-border);
  }

  .place-map-list-title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
  }

  .place-map-list-close {
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--ink-soft);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .place-map-list-places {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .place-map-list-outings {
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
  }

  .place-map-list-outings a {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 1rem;
    color: var(--ink);
  }

  .place-map-list-outings a:hover {
    text-decoration: none;
    background: var(--paper-deep);
  }

  .place-map-list-outings img,
  .place-map-list-outings .place-map-pin-blank {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--border-radius);
  }

  .place-map-list-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .place-map-pin,
    .place-map-list {
      transition: none;
    }
  }
</style>
