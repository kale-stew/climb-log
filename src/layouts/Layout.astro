---
export interface Props {
  title: string
  description?: string
  ogImage?: string
  ogImageAlt?: string
}

const { title, description, ogImage, ogImageAlt } = Astro.props

const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`
const canonicalUrl = `https://kylies.photos${canonicalPath}`
const defaultOgImage = 'https://kylies.photos/open-graph/home.jpg'
const defaultDescription = 'Photos and notes from outside: mostly mountains, sometimes the ocean, lately anywhere I can get to.'
const pageTitle = title === 'Home' ? 'Kylie · Photos & outside journal' : `${title} · kylies.photos`
const imageAlt = ogImageAlt ?? 'A photo from Kylie’s journal'

const navLinks = [
  { name: 'Photos', href: '/photos/' },
  { name: 'Log', href: '/climbs/' },
  { name: 'Peaks', href: '/peaks/' },
  { name: 'Gear', href: '/gear/' },
  { name: 'Blog', href: '/blog/' },
  { name: 'About', href: '/about/' },
]

const currentPath = Astro.url.pathname

const connectLinks = [
  { name: 'Instagram', href: 'https://www.instagram.com/kalestewski/', icon: 'instagram' },
  { name: 'GitHub', href: 'https://github.com/kale-stew', icon: 'github' },
  { name: 'Strava', href: 'https://www.strava.com/athletes/46336787', icon: 'strava' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? defaultDescription} />
    
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage ?? defaultOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kylies.photos" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kyliestew" />
    <meta name="twitter:creator" content="@kyliestew" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description ?? ''} />
    <meta name="twitter:image" content={ogImage ?? defaultOgImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#FAF8F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1A18" media="(prefers-color-scheme: dark)" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/web.manifest" />
    
    <!-- Styles -->
    <link rel="stylesheet" href="/styles/globals.css" />
    
    <!-- Theme init (prevent flash) -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="Home">
          <span class="logo-word">kylies<em>·</em>photos</span>
        </a>
        
        <button
          type="button"
          class="mobile-nav-toggle"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="nav"
          id="nav-toggle"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        
        <nav class="nav" id="nav">
          {navLinks.map(link => (
            <a 
              href={link.href} 
              class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}
              aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
            >
              {link.name}
            </a>
          ))}
          
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">kylies<em>·</em>photos</div>
        <p>A running record of a life outside.</p>
        <p class="footer-tech">
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
          on <a href="https://workers.cloudflare.com" target="_blank" rel="noopener noreferrer">Cloudflare Workers</a>,
          with outings from Notion and photos from photos-api. <a href="https://github.com/kale-stew/climb-log" target="_blank" rel="noopener noreferrer">Source on GitHub.</a>
        </p>
        <nav class="footer-links" aria-label="Footer navigation">
          {navLinks.map(link => <a href={link.href}>{link.name}</a>)}
          {connectLinks.map(link => (
            <a class="footer-social" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.name} title={link.name}>
              {link.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>}
              {link.icon === 'github' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-3 18.51c.48.09.65-.2.65-.46v-1.68c-2.65.58-3.21-1.12-3.21-1.12-.44-1.1-1.08-1.39-1.08-1.39-.87-.6.07-.59.07-.59.96.07 1.46.99 1.46.99.85 1.46 2.23 1.04 2.78.8.09-.62.33-1.04.61-1.28-2.12-.24-4.35-1.06-4.35-4.71 0-1.04.37-1.89.98-2.56-.1-.24-.43-1.21.09-2.53 0 0 .8-.26 2.62.98a9.1 9.1 0 0 1 4.77 0c1.82-1.24 2.62-.98 2.62-.98.52 1.32.19 2.29.09 2.53.61.67.98 1.52.98 2.56 0 3.66-2.23 4.47-4.36 4.71.34.3.65.87.65 1.76v2.61c0 .26.17.56.66.46A9.5 9.5 0 0 0 12 2.5Z" /></svg>}
              {link.icon === 'strava' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.25 4 3.05 6.15h2.4L18 16.8h-3.45l-1.8-3.6-1.8 3.6H7.5l3.3-6.65L7.2 4h2.05Z" /></svg>}
            </a>
          ))}
        </nav>
      </div>
    </footer>

    <script>
      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      // Mobile nav toggle
      const navToggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('nav');
      navToggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('open') ?? false;
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });
      
      // Close mobile nav on link click
      nav?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => nav?.classList.remove('open'));
      });
      
      // Close mobile nav on outside click
      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (nav?.classList.contains('open') && 
            !nav.contains(target) && 
            !navToggle?.contains(target)) {
          nav.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
