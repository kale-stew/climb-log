---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => {
    // Remove .md extension for slug
    const slug = post.id.replace(/\.md$/, '')
    return {
      params: { slug },
      props: { post },
    }
  })
}

const { post } = Astro.props
const { Content } = await render(post)

function getCategory(id: string): string {
  const parts = id.split('/')
  return parts.length > 1 ? parts[0] : 'thoughts'
}

const category = getCategory(post.id)
const categoryLabels: Record<string, string> = {
  hike: 'trip reports',
  gear: 'gear',
  thoughts: 'thoughts',
}

function formatDate(dateStr: string) {
  const date = new Date(dateStr)
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
}

// Extract headers for table of contents
const slug = post.id.replace(/\.md$/, '')
---

<Layout 
  title={post.data.title} 
  description={`${categoryLabels[category]} - ${post.data.title}`}
  ogImage={post.data.previewImgUrl}
  ogImageAlt={post.data.title}
>
  <article class="container blog-post">
    <header class="post-header">
      <a href="/blog" class="back-link">&larr; Back to blog</a>
      <span class={`post-category cat-${category}`}>{categoryLabels[category]}</span>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
    </header>

    {post.data.previewImgUrl && (
      <figure class="hero-image">
        <img src={post.data.previewImgUrl} alt={post.data.title} />
      </figure>
    )}

    <div class="post-body prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">&larr; Back to blog</a>
    </footer>
  </article>
</Layout>

<style>
  .blog-post {
    max-width: 800px;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-3xl);
  }

  .post-header {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    display: inline-block;
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    text-decoration: none;
    margin-bottom: var(--space-lg);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-category {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .post-category.cat-hike {
    color: var(--color-purple, #8b5cf6);
  }

  .post-category.cat-gear {
    color: var(--color-orange, #f97316);
  }

  .post-category.cat-thoughts {
    color: var(--color-pink, #ec4899);
  }

  .post-header h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .post-header time {
    font-size: var(--font-size-base);
    color: var(--color-text-tertiary);
  }

  .hero-image {
    margin: 0 calc(-1 * var(--space-lg)) var(--space-xl);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Prose styles for markdown content */
  .prose {
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .prose :global(h2) {
    font-size: var(--font-size-xl);
    color: var(--color-text);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }

  .prose :global(h3) {
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .prose :global(p) {
    margin-bottom: var(--space-lg);
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
    margin: var(--space-lg) 0;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin: var(--space-lg) 0;
    font-style: italic;
    color: var(--color-text-tertiary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
  }

  .prose :global(li) {
    margin-bottom: var(--space-sm);
  }

  .prose :global(code) {
    background: var(--color-bg-tertiary);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    background: var(--color-bg-tertiary);
    padding: var(--space-lg);
    border-radius: var(--border-radius);
    overflow-x: auto;
    margin: var(--space-lg) 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.75rem;
    }

    .hero-image {
      margin-left: calc(-1 * var(--space-md));
      margin-right: calc(-1 * var(--space-md));
      border-radius: 0;
    }
  }
</style>
