---
import Layout from '../layouts/Layout.astro'
import ClimbTable from '../components/ClimbTable'
import { fillMissingPreviewImages } from '../lib/photo-fallbacks'
import { env } from 'cloudflare:workers'
import type { ClimbListItem } from '../lib/types'
import { getCanonicalPhotos } from '../lib/photos-client'

export const prerender = false

const DB = env.DB

let climbs: ClimbListItem[] = []

if (DB) {
  try {
    // Fetch climbs with only the fields needed for the list view
    const result = await DB.prepare(
      'SELECT id, date, title, slug, preview_img_url, distance, gain, area, state, strava FROM climbs ORDER BY date DESC'
    ).all<ClimbListItem>()
    climbs = result.results || []

    const canonicalPhotos = await getCanonicalPhotos(env.PHOTOS_API_ORIGIN, { limit: 500 })
    await fillMissingPreviewImages(climbs, canonicalPhotos, 200)
  } catch (e) {
    console.error('Failed to fetch climbs:', e)
  }
}
---

<Layout
  title="Log"
  description="A searchable log of my hikes, climbs, trail runs, and other mountain outings since 2019."
  ogImage="https://kylies.photos/open-graph/climb-log.jpg"
  ogImageAlt="A hiker crossing a snowy slope above Colorado's mountain ranges"
>
  <div class="container page">
    <h1>Log</h1>
    <p class="page-subtitle" style="color: var(--color-text-secondary); margin-bottom: var(--space-xl);">
      A complete log of my hikes and climbs. Search, filter, and sort to explore the list.
    </p>

    <ClimbTable client:load climbs={climbs} />
    <noscript><p>The first 50 outings are shown above. Turn on JavaScript to search, sort, and browse the rest.</p></noscript>
  </div>
</Layout>
