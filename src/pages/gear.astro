---
import { env } from 'cloudflare:workers'
import GearCard from '../components/GearCard.astro'
import Layout from '../layouts/Layout.astro'
import {
  buildGearItems,
  categoriesOf,
  formatWeight,
  GEAR_CLIMB_LINKS_SQL,
  GEAR_ROWS_SQL,
  type GearClimbLink,
  type GearItem,
  type GearRow,
  groupByCategory,
  matchesFilters,
  packListsOf,
  packListView,
  parseGearFilters,
} from '../lib/gear'

export const prerender = false

const DB = env.DB as D1Database | undefined

let rows: GearRow[] = []
let links: GearClimbLink[] = []
if (DB) {
  rows = (await DB.prepare(GEAR_ROWS_SQL).all<GearRow>()).results ?? []
  try {
    links = (await DB.prepare(GEAR_CLIMB_LINKS_SQL).all<GearClimbLink>()).results ?? []
  } catch (error) {
    // Climb links are an enhancement; never fail the page over them.
    console.warn('Gear climb links unavailable:', error)
  }
}

const items = buildGearItems(rows, links)
const categories = categoriesOf(items)
const lists = packListsOf(items)
const filters = parseGearFilters(Astro.url.searchParams, categories, lists)
const view = filters.list ? packListView(items, filters.list) : null

const currentGroups = groupByCategory(items.filter(item => item.status === 'current'))
const retired = items.filter(item => item.status === 'retired')
const isVisible = (item: GearItem) => matchesFilters(item, filters)
const statusesByCategory = new Map<string, string[]>()
for (const item of items) {
  const statuses = statusesByCategory.get(item.category.slug) ?? []
  if (!statuses.includes(item.status)) statuses.push(item.status)
  statusesByCategory.set(item.category.slug, statuses)
}
const chipVisible = (slug: string) =>
  filters.status === 'all' || (statusesByCategory.get(slug) ?? []).includes(filters.status)
const anyVisible = items.some(isVisible)
const activeCategory = categories.find(c => c.slug === filters.category)

const statusOptions = [
  { value: 'current', label: 'Current' },
  { value: 'retired', label: 'Retired' },
  { value: 'all', label: 'All' },
] as const

---

<Layout
  title={view ? `${view.list.label} pack list · Gear` : 'Gear'}
  description="The hiking, climbing, and camping gear I use now, plus a few things I've retired."
  ogImage="https://kylies.photos/open-graph/gear-list.jpg"
  ogImageAlt="An orange tent below a rocky mountain glowing at sunrise"
>
  <div class="container page gear-page">
    <h1>Gear</h1>
    <p class="page-subtitle gear-intro">
      What I carry now, what goes in which pack, and what happened to the things I've retired.
    </p>

    {items.length > 0 && (
      <form class="gear-filters" method="get" action="/gear" data-gear-filters>
        {!view && (
          <>
            <fieldset class="gear-segmented">
              <legend class="sr-only">Show</legend>
              {statusOptions.map(option => (
                <label>
                  <input
                    type="radio"
                    name="status"
                    value={option.value}
                    checked={filters.status === option.value}
                  />
                  <span>{option.label}</span>
                </label>
              ))}
            </fieldset>

            <fieldset class="gear-chips">
              <legend class="sr-only">Category</legend>
              <label>
                <input type="radio" name="cat" value="" checked={!filters.category} />
                <span>All</span>
              </label>
              {categories.map(category => (
                <label
                  data-statuses={statusesByCategory.get(category.slug)?.join(' ')}
                  hidden={!chipVisible(category.slug)}
                >
                  <input
                    type="radio"
                    name="cat"
                    value={category.slug}
                    checked={filters.category === category.slug}
                  />
                  <span>{category.label}</span>
                </label>
              ))}
            </fieldset>
          </>
        )}

        {lists.length > 0 && (
          <label class="gear-list-select">
            <span class="sr-only">Pack list</span>
            <select name="list" data-gear-list>
              <option value="">{view ? 'All gear' : 'Pack lists'}</option>
              {lists.map(list => (
                <option value={list.slug} selected={filters.list?.slug === list.slug}>
                  {list.label}
                </option>
              ))}
            </select>
          </label>
        )}

        <button type="submit" class="filter-btn gear-apply">Apply</button>
      </form>
    )}

    {view ? (
      <section class="pack-view" aria-labelledby="pack-title">
        <h2 id="pack-title" class="pack-title">{view.list.label}</h2>
        <p class="pack-count">
          {view.count === 1 ? '1 item' : `${view.count} items`} on this pack list.
        </p>

        {view.groups.map(group => (
          <section class="pack-group">
            <h3>
              <span>{group.category.label}</span>
              {group.grams > 0 && (
                <span class="pack-subtotal">
                  {formatWeight(group.grams)}
                  {group.unweighed > 0 && ` · ${group.unweighed} unweighed`}
                </span>
              )}
            </h3>
            <ul class="pack-rows">
              {group.items.map(item => (
                <li class="pack-row">
                  <div class="pack-thumb">
                    {item.image ? (
                      <img src={item.image.thumb} alt="" width="48" height="48" loading="lazy" decoding="async" />
                    ) : (
                      <span aria-hidden="true">{item.category.emoji}</span>
                    )}
                  </div>
                  <div class="pack-name">
                    {item.brand && <span class="pack-brand">{item.brand}</span>}
                    <span class="pack-item-title">{item.title}</span>
                  </div>
                  <span class="pack-weight">{formatWeight(item.weightG) ?? '—'}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <p class="pack-total">
          <span>Total</span>
          <strong>{view.totalGrams > 0 ? formatWeight(view.totalGrams) : '—'}</strong>
          {view.unweighed > 0 && (
            <span class="pack-unweighed">
              {view.unweighed === 1 ? '1 item unweighed' : `${view.unweighed} items unweighed`}
            </span>
          )}
        </p>
      </section>
    ) : (
      <>
        {currentGroups.map(group => (
          <section class="gear-section" data-gear-section="current" hidden={!group.items.some(isVisible)}>
            <h2>
              <span class="gear-section-emoji" aria-hidden="true">{group.category.emoji}</span>
              {group.category.label}
            </h2>
            <ul class="gear-grid">
              {group.items.map(item => <GearCard item={item} hidden={!isVisible(item)} />)}
            </ul>
          </section>
        ))}

        {retired.length > 0 && (
          <section class="gear-section gear-retired" data-gear-section="retired" hidden={!retired.some(isVisible)}>
            <h2>Retired</h2>
            <p class="gear-section-note">Gear I've moved on from, and what happened to it.</p>
            <ul class="gear-grid">
              {retired.map(item => <GearCard item={item} hidden={!isVisible(item)} />)}
            </ul>
          </section>
        )}

        <p class="gear-empty" data-gear-empty hidden={anyVisible || items.length === 0}>
          <span data-gear-empty-text>
            No {filters.status === 'all' ? '' : `${filters.status} `}gear{activeCategory ? ` in ${activeCategory.label}` : ''}.
          </span>{' '}
          <a href="/gear">Show all current gear</a>
        </p>
      </>
    )}

    {items.length === 0 && <p>No gear found.</p>}
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-gear-filters]')
  if (form) {
    form.classList.add('is-enhanced')
    const cards = [...document.querySelectorAll<HTMLElement>('.gear-card')]
    const sections = [...document.querySelectorAll<HTMLElement>('[data-gear-section]')]
    const empty = document.querySelector<HTMLElement>('[data-gear-empty]')
    const emptyText = document.querySelector<HTMLElement>('[data-gear-empty-text]')
    const list = form.querySelector('[data-gear-list]') as HTMLSelectElement | null

    const value = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? ''

    const chips = [...form.querySelectorAll<HTMLElement>('label[data-statuses]')]
    const header = document.querySelector<HTMLElement>('.header')

    const apply = () => {
      const status = value('status') || 'current'
      for (const chip of chips) {
        chip.hidden = status !== 'all' && !(chip.dataset.statuses ?? '').split(' ').includes(status)
        const input = chip.querySelector('input')
        if (chip.hidden && input?.checked) {
          form.querySelector<HTMLInputElement>('input[name="cat"][value=""]')?.click()
          return
        }
      }
      const cat = value('cat')
      let visible = 0
      for (const card of cards) {
        const show =
          (status === 'all' || card.dataset.status === status) && (!cat || card.dataset.cat === cat)
        card.hidden = !show
        if (show) visible++
      }
      for (const section of sections) {
        section.hidden = !section.querySelector('.gear-card:not([hidden])')
      }
      if (empty && emptyText) {
        empty.hidden = visible > 0
        const label = form.querySelector<HTMLInputElement>(`input[name="cat"][value="${cat}"]`)
          ?.nextElementSibling?.textContent
        emptyText.textContent = `No ${status === 'all' ? '' : `${status} `}gear${cat && label ? ` in ${label}` : ''}.`
      }
      const url = new URL(window.location.href)
      url.searchParams.delete('list')
      status === 'current' ? url.searchParams.delete('status') : url.searchParams.set('status', status)
      cat ? url.searchParams.set('cat', cat) : url.searchParams.delete('cat')
      history.replaceState(null, '', url)

      // When the bar is stuck, bring the results back under it.
      const headerHeight = header?.offsetHeight ?? 0
      if (form.getBoundingClientRect().top <= headerHeight + 1) {
        const first = document.querySelector<HTMLElement>('[data-gear-section]:not([hidden]), [data-gear-empty]:not([hidden])')
        if (first) {
          const top = first.getBoundingClientRect().top + window.scrollY - headerHeight - form.offsetHeight - 16
          if (top < window.scrollY) window.scrollTo({ top })
        }
      }
    }

    form.addEventListener('change', event => {
      if (list && event.target === list) {
        const url = new URL('/gear', window.location.origin)
        if (list.value) url.searchParams.set('list', list.value)
        window.location.assign(url)
        return
      }
      apply()
    })
    form.addEventListener('submit', event => {
      event.preventDefault()
      apply()
    })
  }
</script>

<style>
  .gear-page {
    --gear-plate: #e3e6dc;
    --gear-gap: var(--space-sm);
  }

  :global([data-theme='dark']) .gear-page {
    /* Neutral dark grey, a step above the page so black products stay visible. */
    --gear-plate: #363937;
  }

  .gear-intro {
    max-width: 38rem;
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
  }

  /* Filters */
  .gear-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin: 0 calc(-1 * var(--space-md)) var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    background: var(--paper);
  }

  @media (min-width: 768px) {
    .gear-filters {
      position: sticky;
      top: var(--header-height);
      z-index: 10;
      box-shadow: 0 10px 12px -10px color-mix(in srgb, var(--ink) 18%, transparent);
    }
  }

  :where(.gear-filters fieldset) {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .gear-filters label {
    position: relative;
  }

  .gear-filters input[type='radio'] {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .gear-segmented {
    display: inline-flex;
    border: 1px solid var(--color-border-hover);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .gear-segmented span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .gear-segmented label + label span {
    border-left: 1px solid var(--color-border);
  }

  .gear-chips {
    display: flex;
    gap: var(--space-xs);
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1 1 100%;
    order: 3;
    /* Room for the focus ring inside the scroll box. */
    padding: 4px 4px 4px 2px;
  }

  @media (pointer: fine) {
    .gear-chips {
      flex-wrap: wrap;
      overflow: visible;
    }
  }

  .gear-chips label[hidden] {
    display: none;
  }

  .gear-chips::-webkit-scrollbar {
    display: none;
  }

  .gear-chips label {
    flex-shrink: 0;
  }

  .gear-chips span {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .gear-segmented input:checked + span,
  .gear-chips input:checked + span {
    color: var(--ink);
    background-color: color-mix(in srgb, var(--tab) 70%, var(--paper));
    border-color: color-mix(in srgb, var(--tab) 80%, var(--ink));
  }

  :global([data-theme='dark']) .gear-segmented input:checked + span,
  :global([data-theme='dark']) .gear-chips input:checked + span {
    color: var(--paper);
    background-color: var(--tab);
  }

  .gear-filters input:focus-visible + span {
    outline: 2px solid var(--water);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .gear-segmented input:not(:checked):hover + span,
    .gear-chips input:not(:checked):hover + span {
      color: var(--color-text);
      border-color: var(--color-border-hover);
    }
  }

  .gear-list-select select {
    min-height: 36px;
    min-width: 11rem;
    font-size: 1rem;
  }

  @media (min-width: 768px) {
    .gear-list-select select {
      font-size: var(--font-size-sm);
    }
  }

  .gear-filters.is-enhanced .gear-apply {
    display: none;
  }

  /* Sections */
  .gear-section {
    margin-bottom: var(--space-xl);
  }

  .gear-section h2 {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    margin-bottom: var(--space-md);
  }

  .gear-section-emoji {
    font-size: 0.8em;
  }

  .gear-section-note {
    margin: calc(-1 * var(--space-sm)) 0 var(--space-md);
    color: var(--color-text-secondary);
  }

  [data-gear-section='current']:not([hidden]) ~ .gear-retired {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  /* Grid and cards */
  .gear-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--gear-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 480px) {
    .gear-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 768px) {
    .gear-page { --gear-gap: var(--space-md); }
    .gear-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .gear-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  @media (min-width: 1280px) {
    .gear-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  .gear-empty {
    padding: var(--space-xl) 0;
    color: var(--color-text-secondary);
  }

  .gear-empty a {
    color: var(--color-text-accent);
    text-decoration: underline;
  }

  /* Pack-list view */
  .pack-view {
    max-width: 40rem;
  }

  .pack-title {
    margin: 0;
  }

  .pack-count {
    margin: var(--space-xs) 0 var(--space-lg);
    color: var(--color-text-secondary);
  }

  .pack-group {
    margin-bottom: var(--space-lg);
  }

  .pack-group h3 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    margin: 0 0 var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .pack-subtotal {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }

  .pack-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pack-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    padding: var(--space-xs) 0;
  }

  .pack-thumb {
    width: 3rem;
    height: 3rem;
    background: var(--gear-plate);
    border-radius: var(--border-radius-lg);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .pack-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pack-name {
    min-width: 0;
  }

  .pack-brand {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .pack-item-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .pack-weight {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }

  .pack-total {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-lg) calc(-1 * var(--space-md)) 0;
    padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
    background: var(--paper);
    box-shadow: 0 -10px 12px -10px color-mix(in srgb, var(--ink) 18%, transparent);
    font-family: var(--font-sans);
  }

  .pack-total strong {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .pack-unweighed {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
  }
</style>
