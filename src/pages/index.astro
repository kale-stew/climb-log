---
import Layout from '../layouts/Layout.astro'
import { fillMissingPreviewImages } from '../lib/photo-fallbacks'
import { formatCalendarDate, formatRecentDate } from '../lib/dates'
import { getCanonicalPhotos, type DisplayPhoto } from '../lib/photos-client'
import { env } from 'cloudflare:workers'

export const prerender = false

const DB = env.DB as D1Database | undefined

let recentClimbs: any[] = []
let heroPhoto: DisplayPhoto | null = null
let recentPhotos: DisplayPhoto[] = []
let stats = { totalClimbs: 0, totalPeaks: 0, totalMiles: 0, totalGain: 0 }

if (DB) {
  try {
    const canonicalPhotos = await getCanonicalPhotos(env.PHOTOS_API_ORIGIN, { limit: 100 })
    // Fetch recent climbs
    const climbsResult = await DB.prepare(
      'SELECT id, date, title, slug, preview_img_url, distance, gain, area, state FROM climbs ORDER BY date DESC LIMIT 5'
    ).all()
    recentClimbs = climbsResult.results || []

    // Fill missing preview images from canonical photos.
    await fillMissingPreviewImages(recentClimbs, canonicalPhotos, 800)

    const landscapePhotos = canonicalPhotos
      .filter(photo => (photo.width ?? 0) > (photo.height ?? 0) * 1.25)
      .filter(photo => (photo.width ?? 0) >= 1200)
    const heroCandidates = landscapePhotos.length > 0 ? landscapePhotos : canonicalPhotos
    heroPhoto = heroCandidates[Math.floor(Math.random() * heroCandidates.length)] ?? null
    recentPhotos = canonicalPhotos.filter(photo => photo.id !== heroPhoto?.id).slice(0, 7)

    // Fetch stats
    const statsResult = await DB.prepare(`
      SELECT 
        (SELECT COUNT(*) FROM climbs) as totalClimbs,
        (SELECT COUNT(*) FROM peaks WHERE first_completed IS NOT NULL) as totalPeaks,
        (SELECT COALESCE(SUM(distance), 0) FROM climbs) as totalMiles,
        (SELECT COALESCE(SUM(gain), 0) FROM climbs) as totalGain
    `).first<{ totalClimbs: number; totalPeaks: number; totalMiles: number; totalGain: number }>()
    
    if (statsResult) {
      stats = {
        totalClimbs: statsResult.totalClimbs || 0,
        totalPeaks: statsResult.totalPeaks || 0,
        totalMiles: Math.round(statsResult.totalMiles || 0),
        totalGain: Math.round(statsResult.totalGain || 0),
      }
    }
  } catch (e) {
    console.error('Failed to fetch data:', e)
  }
}

function formatNumber(n: number): string {
  return n.toLocaleString()
}

function getOutingType(title: string | null): string {
  const match = title?.match(/^(Trail Run|Hike|Climb|Backpack|Ski)\b/i)
  if (!match) return 'outing'
  return match[1].toLowerCase()
}

function getOutingTitle(title: string | null): string {
  return title?.replace(/^(Trail Run|Hike|Climb|Backpack|Ski)\s+/i, '') || 'Untitled outing'
}

function getPhotoAlt(photo: DisplayPhoto): string {
  return photo.caption || photo.title || [photo.area, photo.state].filter(Boolean).join(', ') || 'Photo from outside'
}
---

<Layout
  title="Home"
  description="Photos and notes from outside: mostly mountains, sometimes the ocean, lately anywhere I can get to."
  ogImage="https://kylies.photos/open-graph/home.jpg"
  ogImageAlt="Snow-covered mountains above a forested trail in Colorado"
>
  <figure class="hero-photo">
    <img
      src={heroPhoto ? `/img/${heroPhoto.id}/?w=1600` : '/open-graph/home.jpg'}
      alt={heroPhoto ? getPhotoAlt(heroPhoto) : 'Snow-covered mountains above a forested trail in Colorado'}
      width={heroPhoto?.width ?? 1200}
      height={heroPhoto?.height ?? 630}
      fetchpriority="high"
    />
    {heroPhoto && (
      <figcaption>
        <span>{heroPhoto.title || heroPhoto.caption || 'Latest photo'}</span>
        {heroPhoto.area && <span>{heroPhoto.area}{heroPhoto.state && `, ${heroPhoto.state}`}</span>}
      </figcaption>
    )}
  </figure>

  <div class="container home-content">
    <header class="home-intro">
      <h1>Proof I went <em>outside.</em></h1>
      <p>Photos and notes from outside: mostly mountains, sometimes the ocean, lately anywhere I can get to.</p>
      <a href="/photos/">see all the photos <span aria-hidden="true">→</span></a>
    </header>

    {recentPhotos.length > 0 && (
      <section class="photo-section" aria-labelledby="photo-heading">
        <div class="section-heading">
          <h2 id="photo-heading">A few recent frames</h2>
          <span>the camera has been getting out more than the log</span>
        </div>
        <div class="photo-strip">
          {recentPhotos.map(photo => (
            <a href="/photos/" class="photo-strip-item" aria-label={`View ${getPhotoAlt(photo)}`}>
              <img src={`/img/${photo.id}/?w=800`} alt="" loading="lazy" width={photo.width ?? 800} height={photo.height ?? 600} />
              {(photo.title || photo.area) && (
                <span aria-hidden="true">{photo.title || photo.area}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="stats-note" aria-label="Journal totals">
      <p>
        <em>Since 2019:</em> {formatNumber(stats.totalPeaks)} summits, {formatNumber(stats.totalMiles)} miles,
        and about {formatNumber(Math.round(stats.totalGain / 1000) * 1000)} feet of uphill
        <span>(and only 3 ankle surgeries).</span>
      </p>
    </section>

    <section class="outing-section">
      <div class="section-heading">
        <h2>From the log</h2>
        <a href="/climbs/">all {formatNumber(stats.totalClimbs)} outings <span aria-hidden="true">→</span></a>
      </div>

      {recentClimbs.length > 0 ? (
        <div class="outing-list">
          {recentClimbs.slice(0, 3).map((climb) => (
            <a href={climb.slug ? `/blog/hike/${climb.slug}/` : `/climbs/?outing=${encodeURIComponent(climb.id)}`} class="outing-entry">
              <div class="outing-thumb">
                {climb.preview_img_url ? (
                  <img
                    src={climb.preview_img_url}
                    alt=""
                    loading="lazy"
                  />
                ) : (
                  <span aria-hidden="true">↗</span>
                )}
              </div>
              <div class="outing-copy">
                <p class="outing-tag">{getOutingType(climb.title)}{climb.state && ` · ${climb.state}`}</p>
                <h3>{getOutingTitle(climb.title)}</h3>
                <p class="outing-meta">
                  {climb.date && (
                    <time datetime={climb.date} title={formatCalendarDate(climb.date)}>
                      {formatRecentDate(climb.date)}
                    </time>
                  )}
                  {climb.area && ` · ${climb.area}`}
                </p>
                {climb.distance && climb.gain && (
                  <p class="outing-stats">
                    {climb.distance} mi · {formatNumber(climb.gain)} ft gain
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p>No outings found. <a href="/climbs/">View the log</a></p>
      )}
    </section>
  </div>

  <style>
    .hero-photo {
      width: min(calc(100% - 2rem), 1480px);
      margin: 1rem auto 0;
    }
    .hero-photo img {
      display: block;
      width: 100%;
      height: min(72vh, 780px);
      min-height: 520px;
      border-radius: 0.5rem;
      object-fit: cover;
      filter: saturate(0.9);
    }
    .hero-photo figcaption {
      display: flex;
      justify-content: space-between;
      gap: var(--space-md);
      padding: 0.65rem 0.25rem 0;
      color: var(--color-text-tertiary);
      font-family: var(--font-serif);
      font-size: var(--font-size-sm);
      font-style: italic;
    }
    .home-content { max-width: 1180px; padding-bottom: 7rem; }
    .home-intro { max-width: 880px; padding: 5.5rem 0 4.5rem; }
    .home-intro h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.8rem, 5.5vw, 5rem);
      font-weight: 400;
      letter-spacing: -0.05em;
      line-height: 0.9;
      margin: 0 0 1rem;
    }
    .home-intro h1 em { color: var(--color-accent-orange); font-style: italic; }
    .home-intro p { max-width: 680px; font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.55; }
    .home-intro a { display: inline-block; margin-top: var(--space-md); font-size: var(--font-size-sm); }
    .photo-section { padding: 1rem 0 5rem; }
    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-xl);
      margin-bottom: 2rem;
    }
    .section-heading h2 {
      margin: 0;
      font-size: clamp(1.7rem, 3vw, 2.4rem);
      font-weight: 400;
      letter-spacing: -0.03em;
    }
    .section-heading > span,
    .section-heading > a { color: var(--color-text-tertiary); font-size: var(--font-size-sm); }
    .section-heading > a:hover { color: var(--color-text-accent); }
    .photo-strip {
      columns: 4 180px;
      column-gap: 0.75rem;
    }
    .photo-strip-item {
      display: block;
      position: relative;
      break-inside: avoid;
      overflow: hidden;
      border-radius: 0.35rem;
      background: var(--color-bg-secondary);
      margin-bottom: 0.75rem;
    }
    .photo-strip-item img {
      display: block;
      width: 100%;
      height: auto;
      transition: transform 0.5s ease;
    }
    .photo-strip-item:hover img { transform: scale(1.025); }
    .photo-strip-item span {
      position: absolute;
      right: 0.6rem;
      bottom: 0.45rem;
      left: 0.6rem;
      color: white;
      font-family: var(--font-serif);
      font-size: var(--font-size-sm);
      font-style: italic;
      opacity: 0;
      text-shadow: 0 1px 8px rgba(0,0,0,0.8);
      transition: opacity 0.2s ease;
    }
    .photo-strip-item:hover span { opacity: 1; }
    .stats-note {
      margin: 0 0 6rem;
      padding: 2.25rem 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .stats-note p { margin: 0; color: var(--color-text-primary); font-family: var(--font-serif); font-size: clamp(1.2rem, 2.2vw, 1.65rem); }
    .stats-note p em { color: var(--color-accent); font-weight: 600; }
    .stats-note p span { color: var(--color-text-tertiary); font-style: italic; }
    .outing-section { padding-bottom: 2rem; }
    .outing-list { border-top: 1px solid var(--color-border); }
    .outing-entry {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: var(--space-xl);
      align-items: center;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--color-border);
      color: inherit;
      text-decoration: none;
    }
    .outing-entry:hover { text-decoration: none; }
    .outing-thumb {
      display: grid;
      place-items: center;
      width: 160px;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 0.35rem;
      background: var(--color-bg-secondary);
      color: var(--color-text-tertiary);
      font-family: var(--font-serif);
      font-size: 1.5rem;
    }
    .outing-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .outing-tag { margin: 0 0 0.25rem; color: var(--color-accent); font-size: var(--font-size-xs); text-transform: lowercase; }
    .outing-copy h3 { margin: 0 0 0.35rem; font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 400; }
    .outing-entry:hover h3 { color: var(--color-text-accent); }
    .outing-meta,
    .outing-stats { margin: 0; color: var(--color-text-tertiary); font-size: var(--font-size-sm); }
    .outing-stats { margin-top: 0.2rem; }

    @media (hover: none) {
      .photo-strip-item span { opacity: 1; }
    }

    @media (max-width: 768px) {
      .hero-photo img { height: 62vh; min-height: 420px; }
      .hero-photo figcaption { align-items: flex-start; flex-direction: column; gap: 0; }
      .home-intro { padding: 4rem 0; }
      .section-heading { align-items: flex-start; flex-direction: column; }
      .photo-strip { columns: 2 140px; }
      .outing-entry { grid-template-columns: 100px 1fr; gap: var(--space-lg); }
      .outing-thumb { width: 100px; }
    }
  </style>
</Layout>
