---
import Layout from '../layouts/Layout.astro'
import { env } from 'cloudflare:workers'
import { formatCalendarDate, formatRecentDate } from '../lib/dates'
import { formatNumber, loadJournal, photoAlt, roundedFeet } from '../lib/journal-data'
import {
  buildChapters,
  chapterSlugFor,
  normalizeState,
  outingHref,
  outingName,
  outingType,
  yearOf,
  yearSpan,
} from '../lib/places'

export const prerender = false

const journal = await loadJournal(env, 800)
const chapters = buildChapters(journal.outings)
const recentWithPhotos = journal.outings.filter(outing => outing.preview_img_url).slice(0, 3)
const latest = recentWithPhotos[Math.floor(Math.random() * recentWithPhotos.length)] ?? journal.outings[0]
const rest = journal.outings.filter(outing => outing.id !== latest?.id)
const lately = rest.slice(0, 7)
const latestChapter = latest ? chapters.find(chapter => chapter.slug === chapterSlugFor(latest.state)) : null
const frames = journal.photos.slice(0, 6)
const sinceYear = yearOf(journal.totals.firstDate)

function placeOf(area: string | null, state: string | null): string {
  return [area, normalizeState(state)].filter(Boolean).join(', ')
}
---

<Layout
  title="Home"
  description="Photos and notes from outside: mostly mountains, sometimes the ocean, lately anywhere I can get to."
  ogImage="https://kylies.photos/open-graph/home.jpg"
  ogImageAlt="Snow-covered mountains above a forested trail in Colorado"
>
  <div class="container home">
    <header class="masthead">
      <h1>Proof I went outside.</h1>
      <p class="masthead-note">
        Photos and notes from outside: mostly mountains, sometimes the ocean, lately anywhere I can get to.
        {journal.totals.outings > 0 && (
          <>
            {' '}{sinceYear ? `Since ${sinceYear}: ` : ''}
            <span class="tally">{formatNumber(journal.totals.outings)} outings</span>,{' '}
            <span class="tally">{formatNumber(journal.totals.miles)} miles</span>,{' '}
            <span class="tally">{roundedFeet(journal.totals.gain)} feet</span> of climbing, and{' '}
            <span class="tally">{formatNumber(journal.totals.summits)} summits</span>.
          </>
        )}
      </p>
    </header>

    {journal.loadError && (
      <p class="home-error">The journal couldn't be loaded right now. Photos and older trip reports are still available.</p>
    )}

    {latest && (
      <section class="spread" aria-labelledby="latest-heading">
        <article class="latest">
          {latest.preview_img_url && (
            <a class="latest-photo photo-plate" href={outingHref(latest)} tabindex="-1" aria-hidden="true">
              <img
                src={latest.preview_img_url.replace(/w=\d+/, 'w=1600')}
                alt=""
                width="1200"
                height="800"
                fetchpriority="high"
              />
            </a>
          )}
          <p class="latest-meta">
            {latest.date && (
              <time class="entry-date" datetime={latest.date}>
                {formatCalendarDate(latest.date, { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            )}
            <span>{placeOf(latest.area, latest.state)}</span>
          </p>
          <h2 id="latest-heading"><a href={outingHref(latest)}>{outingName(latest.title)}</a></h2>
          <p class="latest-stats">
            <span class="logbook-kind">{outingType(latest.title)}</span>
            {latest.distance && <span class="measure">{latest.distance.toFixed(1)} mi</span>}
            {latest.gain && <span class="measure">{formatNumber(latest.gain)} ft gain</span>}
          </p>
          {latestChapter && (
            <a class="text-link" href={`/places/${latestChapter.slug}`}>
              From chapter {latestChapter.number}, {latestChapter.name} <span aria-hidden="true">→</span>
            </a>
          )}
        </article>

        <aside class="lately" aria-labelledby="lately-heading">
          <div class="section-head">
            <h2 id="lately-heading">Lately</h2>
            <a class="text-link" href="/climbs">The whole journal <span aria-hidden="true">→</span></a>
          </div>
          <ol class="logbook">
            {lately.map(outing => (
              <li class="logbook-row lately-row">
                <span class="entry-date">{outing.date ? formatRecentDate(outing.date) : '—'}</span>
                <div>
                  <h3><a href={outingHref(outing)}>{outingName(outing.title)}</a></h3>
                  <p class="logbook-place">{placeOf(outing.area, outing.state)}</p>
                </div>
              </li>
            ))}
          </ol>
        </aside>
      </section>
    )}

    {chapters.length > 0 && (
      <section class="section" aria-labelledby="chapters-heading">
        <div class="section-head">
          <h2 id="chapters-heading">The route book</h2>
          <a class="text-link" href="/places">All places <span aria-hidden="true">→</span></a>
        </div>
        <ol class="chapter-index">
          {chapters.map(chapter => (
            <li>
              <a href={`/places/${chapter.slug}`}>
                <span class="chapter-number">No. {chapter.number}</span>
                <span class="chapter-index-name">{chapter.name}</span>
                <span class="measure">{yearSpan(chapter)}</span>
                <span class="measure chapter-index-count">{formatNumber(chapter.count)} outings</span>
                {chapter.cover?.preview_img_url ? (
                  <span class="chapter-index-thumb photo-plate">
                    <img src={chapter.cover.preview_img_url.replace(/w=\d+/, 'w=400')} alt="" loading="lazy" width="400" height="300" />
                  </span>
                ) : (
                  <span />
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {frames.length > 0 && (
      <section class="section" aria-labelledby="frames-heading">
        <div class="section-head">
          <h2 id="frames-heading">Recent frames</h2>
          <a class="text-link" href="/photos">All the photos <span aria-hidden="true">→</span></a>
        </div>
        <div class="frames">
          {frames.map(photo => (
            <a class="frame" href="/photos" aria-label={`View photos, including ${photoAlt(photo)}`}>
              <span class="photo-plate frame-image">
                <img src={`/img/${photo.id}/?w=800`} alt="" loading="lazy" width={photo.width ?? 800} height={photo.height ?? 600} />
              </span>
              {(photo.title || photo.area) && <span class="caption">{photo.title || photo.area}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <style>
    .home {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-2xl);
    }

    .masthead {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: end;
      padding-bottom: var(--space-lg);
      border-bottom: 1px solid var(--ink);
    }

    .masthead h1 {
      margin: 0;
      font-size: clamp(2.2rem, 4vw, 3.1rem);
      line-height: 1.05;
      text-wrap: wrap;
    }

    .masthead-note {
      max-width: 34rem;
      margin: 0;
      font-size: var(--font-size-lg);
    }

    .tally {
      font-weight: 650;
      color: var(--ink);
      white-space: nowrap;
    }

    .home-error {
      margin-top: var(--space-lg);
    }

    .spread {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      gap: var(--space-xl) var(--space-2xl);
      margin-top: var(--space-xl);
    }

    .latest-photo {
      aspect-ratio: 3 / 2;
      margin-bottom: var(--space-md);
    }

    .latest-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem var(--space-md);
      margin-bottom: 0.25rem;
      font-size: var(--font-size-base);
      color: var(--ink-soft);
    }

    .latest h2 {
      margin-bottom: 0.35rem;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
    }

    .latest h2 a {
      color: var(--ink);
    }

    .latest h2 a:hover {
      color: var(--water);
    }

    .latest-stats {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-md);
      margin-bottom: var(--space-sm);
    }

    .lately .section-head h2 {
      font-size: var(--font-size-xl);
    }

    .lately-row {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      padding: 0.55rem 0;
    }

    .lately-row h3 {
      font-size: var(--font-size-base);
    }

    .lately-row .logbook-place {
      font-size: var(--font-size-sm);
    }

    .chapter-index {
      list-style: none;
    }

    .chapter-index a {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr) 7rem 7.5rem 88px;
      gap: var(--space-md);
      align-items: center;
      padding: 0.55rem 0;
      color: var(--ink);
      border-bottom: 1px dashed var(--color-border-hover);
    }

    .chapter-index li:last-child a {
      border-bottom: 0;
    }

    .chapter-index a:hover {
      text-decoration: none;
      background: color-mix(in srgb, var(--paper-deep) 70%, transparent);
    }

    .chapter-index a:hover .chapter-index-name {
      color: var(--water);
    }

    .chapter-index-name {
      font-size: var(--font-size-xl);
      font-weight: 650;
    }

    .chapter-index-count {
      text-align: right;
    }

    .chapter-index-thumb {
      width: 88px;
      aspect-ratio: 4 / 3;
    }

    .frames {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-md);
    }

    .frame {
      display: block;
      color: inherit;
    }

    .frame:hover {
      text-decoration: none;
    }

    .frame-image {
      aspect-ratio: 4 / 5;
    }

    .frame .caption {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    @media (max-width: 960px) {
      .masthead,
      .spread {
        grid-template-columns: 1fr;
      }

      .masthead {
        gap: var(--space-sm);
      }

      .frames {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .chapter-index a {
        grid-template-columns: 3.75rem minmax(0, 1fr) 72px;
        row-gap: 0;
      }

      .chapter-index a > .measure {
        display: none;
      }

      .chapter-index-thumb {
        width: 72px;
      }

      .frames {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>
</Layout>
