---
import Layout from '../layouts/Layout.astro'
import ClimbTable from '../components/ClimbTable'
import { fillMissingPreviewImages } from '../lib/photo-fallbacks'
import { env } from 'cloudflare:workers'
import type { ClimbListItem } from '../lib/types'
import { getCanonicalPhotos, getClimbPhotoAssignments } from '../lib/photos-client'

export const prerender = false

const DB = env.DB

let climbs: ClimbListItem[] = []
let climbImages: Record<string, Array<{ id: string; src: string; alt: string; title: string | null; caption: string | null; area: string | null; state: string | null; date: string | null; camera: string | null; width: number | null; height: number | null }>> = {}

if (DB) {
  try {
    // Fetch climbs with only the fields needed for the list view
    const result = await DB.prepare(
      'SELECT id, date, title, slug, preview_img_url, distance, gain, area, state, strava FROM climbs ORDER BY date DESC'
    ).all<ClimbListItem>()
    climbs = result.results || []

    const [canonicalPhotos, assignments] = await Promise.all([
      getCanonicalPhotos(env.PHOTOS_API_ORIGIN, { limit: 1500 }),
      getClimbPhotoAssignments(env.PHOTOS_API_ORIGIN),
    ])
    fillMissingPreviewImages(climbs, canonicalPhotos, 200, assignments)

    const photosById = new Map(canonicalPhotos.map(photo => [photo.id, photo]))
    climbImages = {}
    for (const [climbId, entries] of assignments) {
      climbImages[climbId] = entries
        .slice()
        .sort((a, b) => Number(b.primary) - Number(a.primary))
        .map(entry => photosById.get(entry.photoId))
        .filter((photo): photo is (typeof canonicalPhotos)[number] => Boolean(photo))
        .map(photo => ({
          id: photo.id,
          src: `/img/${encodeURIComponent(photo.id)}?w=1600`,
          alt: photo.caption || photo.title || 'Photo',
          title: photo.title,
          caption: photo.caption,
          area: photo.area,
          state: photo.state,
          date: photo.date,
          camera: null,
          width: photo.width,
          height: photo.height,
        }))
    }
  } catch (e) {
    console.error('Failed to fetch climbs:', e)
  }
}

// Render the requested page on the server so ?page=N and ?outing= links work
// without JavaScript. The table's default order (date, newest first) matches
// the query above.
const PAGE_SIZE = 50
const totalPages = Math.max(1, Math.ceil(climbs.length / PAGE_SIZE))
const outingId = Astro.url.searchParams.get('outing')
const outingIndex = outingId ? climbs.findIndex(climb => climb.id === outingId) : -1
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '', 10)
const initialPage =
  outingIndex >= 0
    ? Math.floor(outingIndex / PAGE_SIZE) + 1
    : Number.isFinite(requestedPage)
      ? Math.min(Math.max(requestedPage, 1), totalPages)
      : 1
---

<Layout
  title="Journal"
  description="A searchable journal of my hikes, climbs, trail runs, and other mountain outings since 2015."
  ogImage="https://kylies.photos/open-graph/climb-log.jpg"
  ogImageAlt="A hiker crossing a snowy slope above Colorado's mountain ranges"
>
  <div class="container page">
    <h1>Journal</h1>
    <p class="page-subtitle journal-intro">
      Every outing, newest first. The longer write-ups live in the <a href="/blog">trip reports</a>, and the same
      entries are grouped by place in <a href="/places">the route book</a>.
    </p>

    <ClimbTable client:load climbs={climbs} climbImages={climbImages} pageSize={PAGE_SIZE} initialPage={initialPage} />
    <noscript><p>Turn on JavaScript to search, filter, and sort the journal.</p></noscript>
  </div>

  <style>
    .journal-intro {
      margin-bottom: var(--space-xl);
    }
  </style>
</Layout>
