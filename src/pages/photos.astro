---
import Layout from '../layouts/Layout.astro'
import PhotoGallery from '../components/PhotoGallery'
import { env } from 'cloudflare:workers'
import { getCanonicalPhotos } from '../lib/photos-client'

export const prerender = false

// Keep the existing initial cap until the gallery gains server-side pagination.
const photos = await getCanonicalPhotos(env.PHOTOS_API_ORIGIN, { limit: 500 })
---

<Layout title="Photos" description="A gallery of my favorite hiking and climbing photos." ogImage="https://kylies.photos/open-graph/photos.jpg">
  <div class="container page">
    <header class="photos-intro">
      <p>Kylie's photo journal</p>
      <h1>Photos from the trail.</h1>
      <span>Mountains, weather, friends, and the small things worth remembering.</span>
    </header>

    <PhotoGallery client:only="react" photos={photos} />
  </div>

  <style>
    .photos-intro { padding: 3rem 0 4rem; }
    .photos-intro p {
      margin-bottom: 1rem;
      color: var(--color-text-accent);
      font-family: var(--font-serif);
      font-size: 1rem;
      font-style: italic;
      letter-spacing: 0.02em;
    }
    .photos-intro h1 {
      margin: 0 0 1rem;
      font-size: clamp(2.8rem, 5vw, 4.8rem);
      font-weight: 400;
      letter-spacing: -0.04em;
      line-height: 0.98;
    }
    .photos-intro span { color: var(--color-text-tertiary); font-size: 1.05rem; }
  </style>
</Layout>
