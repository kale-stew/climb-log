---
import Layout from '../layouts/Layout.astro'
import PhotoGallery from '../components/PhotoGallery'
import { env } from 'cloudflare:workers'
import { getCollectionPage, type PhotoPage } from '../lib/photos-client'

export const prerender = false

const COLLECTION = 'portfolio'
let firstPage: PhotoPage = { photos: [], total: 0 }
try {
  if (env.PHOTOS_API_ORIGIN) firstPage = await getCollectionPage(env.PHOTOS_API_ORIGIN, COLLECTION, { limit: 60 })
} catch (error) {
  console.error('Failed to fetch portfolio photos:', error)
}
---

<Layout
  title="Photos"
  description="Photos from Colorado, California, Norway, Hawaiʻi, and wherever I end up next."
  ogImage="https://kylies.photos/open-graph/photos.jpg"
  ogImageAlt="Two mountain goats standing on a rocky ridge at sunrise"
>
  <div class="container page">
    <header class="photos-intro">
      <h1>Photos from outside.</h1>
      <p class="page-subtitle">Mountains, weather, friends, and the small things worth remembering.</p>
    </header>

    <PhotoGallery
      client:load
      photos={firstPage.photos}
      total={firstPage.total}
      apiOrigin={env.PHOTOS_API_ORIGIN}
      collection={COLLECTION}
    />
    <noscript><p>The first {firstPage.photos.length} photos are shown above. Turn on JavaScript to search and load more.</p></noscript>
  </div>

  <style>
    .photos-intro {
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--ink);
    }
    .photos-intro h1 {
      margin: 0 0 0.4rem;
      font-size: clamp(2.3rem, 4.4vw, 3.2rem);
    }
    .photos-intro .page-subtitle { margin: 0; }
  </style>
</Layout>
