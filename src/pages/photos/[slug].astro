---
import Layout from '../../layouts/Layout.astro'
import { env } from 'cloudflare:workers'
import { formatCalendarDate } from '../../lib/dates'
import { photoImagePath, photoPath, resolvePhotoPage } from '../../lib/photo-pages'
import { imageVersion } from '../../lib/photos-client'
import { AUTHOR_NAME, absoluteUrl, personRef } from '../../lib/seo'

export const prerender = false

if (!env.DB) return new Response('Photo pages are not configured', { status: 503 })

const resolution = await resolvePhotoPage(env.DB, env.PHOTOS_API_ORIGIN, Astro.params.slug ?? '')
if (resolution.kind === 'not-found') return new Response('Photo not found', { status: 404 })
if (resolution.kind === 'redirect') return Astro.redirect(photoPath(resolution.slug), 301)

const { photo, slug } = resolution
const version = imageVersion(photo)
const title = photo.title || 'Untitled photo'
const place = [photo.area, photo.state].filter(Boolean).join(', ') || photo.location
const dateLabel = photo.date ? formatCalendarDate(photo.date, { month: 'long', day: 'numeric', year: 'numeric' }) : null
const alt = [photo.caption || photo.title, place].filter(Boolean).join(', ') || 'Photo'
const description =
  photo.caption || [title, place, dateLabel].filter(Boolean).join(' · ') || `A photo by ${AUTHOR_NAME}`
const large = photoImagePath(slug, 'webp', 1600, version)
const medium = photoImagePath(slug, 'webp', 800, version)
const share = absoluteUrl(photoImagePath(slug, 'jpg', 1600, version))

const imageObject = {
  '@type': 'ImageObject',
  '@id': `${absoluteUrl(photoPath(slug))}#image`,
  name: title,
  caption: photo.caption ?? undefined,
  contentUrl: share,
  url: absoluteUrl(photoPath(slug)),
  width: photo.width ?? undefined,
  height: photo.height ?? undefined,
  dateCreated: photo.date ?? undefined,
  contentLocation: place ? { '@type': 'Place', name: place } : undefined,
  creator: personRef,
  copyrightHolder: personRef,
  creditText: AUTHOR_NAME,
}

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600')
---

<Layout title={title} description={description} ogImage={share} ogImageAlt={alt} jsonLd={[imageObject]}>
  <article class="container page photo-page">
    <figure class="photo-page-figure">
      <img
        src={large}
        srcset={`${medium} 800w, ${large} 1600w`}
        sizes="(max-width: 900px) 100vw, 1200px"
        alt={alt}
        width={photo.width ?? 1600}
        height={photo.height ?? 1067}
        fetchpriority="high"
        style={photo.accent_color ? `background-color: ${photo.accent_color}` : undefined}
      />
    </figure>
    <header class="photo-page-text">
      <h1>{title}</h1>
      {photo.caption && photo.caption !== photo.title && <p class="page-subtitle">{photo.caption}</p>}
      {(place || dateLabel) && (
        <p class="photo-page-meta measure">
          {place && <span>{place}</span>}
          {place && dateLabel && <span aria-hidden="true"> · </span>}
          {dateLabel && <time datetime={photo.date ?? undefined}>{dateLabel}</time>}
        </p>
      )}
      <a class="text-link" href={`/photos?photo=${encodeURIComponent(photo.id)}`}>
        See it with the rest of the photos <span aria-hidden="true">→</span>
      </a>
    </header>
  </article>

  <style>
    .photo-page-figure {
      margin: 0 0 var(--space-lg);
    }
    .photo-page-figure img {
      display: block;
      width: 100%;
      height: auto;
      max-height: calc(100dvh - var(--header-height) - var(--space-2xl));
      object-fit: contain;
      background: var(--paper-deep);
    }
    .photo-page-text {
      max-width: var(--reading-width);
    }
    .photo-page-text h1 {
      margin: 0 0 0.4rem;
      font-size: clamp(1.9rem, 3.6vw, 2.6rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .photo-page-text .page-subtitle {
      margin: 0 0 0.5rem;
    }
    .photo-page-meta {
      margin: 0 0 var(--space-md);
    }
    @media (max-width: 768px) {
      .photo-page {
        padding-top: var(--space-md);
      }
    }
  </style>
</Layout>
